{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "DocumentManagementMicroservicesIdentityService",
    "Audience": "DocumentManagementMicroservicesApiGateway"
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "documentsRoute": {
        "ClusterId": "documentsCluster",
        "AuthorizationPolicy": "RequireJwt",
        "Match": {
          "Path": "/api/v1/documents/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://identityservice"
          }
        }
      },
      "documentsCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://documentservice"
          }
        }
      }
    }
  }
}
